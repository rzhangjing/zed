{
  "version": 8,
  "name": "RustGIS vector tiles",
  "sources": {"vector": {"type": "vector", "tiles": []}},
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#f2efe9"}},
    {"id": "earth", "type": "fill", "source": "vector", "source-layer": "earth", "paint": {"fill-color": "#f2efe9"}},
    {"id": "wood", "type": "fill", "source": "vector", "source-layer": "landcover",
      "filter": ["match", ["coalesce", ["get", "class"], ["get", "kind"], ""], ["wood", "forest"], true, false],
      "paint": {"fill-color": "#d6e8c8", "fill-opacity": 0.8}},
    {"id": "grass", "type": "fill", "source": "vector", "source-layer": "landcover",
      "filter": ["match", ["coalesce", ["get", "class"], ["get", "kind"], ""], ["grass", "grassland", "scrub", "farmland", "wetland"], true, false],
      "paint": {"fill-color": "#e4eed6", "fill-opacity": 0.7}},
    {"id": "ice", "type": "fill", "source": "vector", "source-layer": "landcover",
      "filter": ["match", ["coalesce", ["get", "class"], ["get", "kind"], ""], ["ice", "glacier", "barren", "sand"], true, false],
      "paint": {"fill-color": "#f8f8f4"}},
    {"id": "land-shortbread", "type": "fill", "source": "vector", "source-layer": "land",
      "filter": ["match", ["get", "kind"], ["forest", "wood", "park", "grass", "meadow", "garden", "recreation_ground", "village_green"], true, false],
      "paint": {"fill-color": "#dcebcf", "fill-opacity": 0.8}},
    {"id": "landuse-park", "type": "fill", "source": "vector", "source-layer": "park", "paint": {"fill-color": "#d8eacb", "fill-opacity": 0.8}},
    {"id": "landuse", "type": "fill", "source": "vector", "source-layer": "landuse",
      "paint": {"fill-color": ["match", ["coalesce", ["get", "class"], ["get", "kind"], ""],
        ["park", "nature_reserve", "national_park", "protected_area", "garden", "playground", "pitch", "golf_course", "cemetery", "grass", "forest", "wood", "farmland", "meadow"], "#d8eacb",
        ["residential", "neighbourhood", "suburb", "quarter"], "#ebe7e0",
        ["industrial", "commercial", "retail", "railway", "garages"], "#e8e3e8",
        ["hospital", "school", "college", "university", "kindergarten", "stadium"], "#f3e7e0",
        ["beach", "sand"], "#f6eed8",
        "#ebe8e2"], "fill-opacity": 0.75}},
    {"id": "sites", "type": "fill", "source": "vector", "source-layer": "sites", "paint": {"fill-color": "#ebe5e0", "fill-opacity": 0.6}},
    {"id": "water", "type": "fill", "source": "vector", "source-layer": "water", "filter": ["==", ["geometry-type"], "Polygon"], "paint": {"fill-color": "#aad3df"}},
    {"id": "ocean", "type": "fill", "source": "vector", "source-layer": "ocean", "paint": {"fill-color": "#aad3df"}},
    {"id": "water-polygons", "type": "fill", "source": "vector", "source-layer": "water_polygons", "paint": {"fill-color": "#aad3df"}},
    {"id": "waterway", "type": "line", "source": "vector", "source-layer": "waterway",
      "paint": {"line-color": "#aad3df", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, ["match", ["get", "class"], ["river", "canal"], 3, 1], 18, ["match", ["get", "class"], ["river", "canal"], 10, 3]]}},
    {"id": "water-lines", "type": "line", "source": "vector", "source-layer": "water_lines",
      "paint": {"line-color": "#aad3df", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2, 18, 6]}},
    {"id": "water-protomaps-lines", "type": "line", "source": "vector", "source-layer": "water", "filter": ["==", ["geometry-type"], "LineString"],
      "paint": {"line-color": "#aad3df", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2, 18, 6]}},
    {"id": "aeroway", "type": "fill", "source": "vector", "source-layer": "aeroway", "filter": ["==", ["geometry-type"], "Polygon"], "paint": {"fill-color": "#e4e1ea"}},
    {"id": "building", "type": "fill", "source": "vector", "source-layer": "building", "minzoom": 13, "paint": {"fill-color": "#e0d8cf", "fill-outline-color": "#cfc5ba"}},
    {"id": "buildings", "type": "fill", "source": "vector", "source-layer": "buildings", "minzoom": 13, "paint": {"fill-color": "#e0d8cf", "fill-outline-color": "#cfc5ba"}},
    {"id": "roads-minor", "type": "line", "source": "vector", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track", "path", "pedestrian"], true, false], "minzoom": 12,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 0.5, 16, 4, 20, 18]}},
    {"id": "roads-major", "type": "line", "source": "vector", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": ["match", ["get", "class"], ["motorway", "trunk"], "#f6c48a", ["primary"], "#fbdca5", "#ffffff"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.5, 10, ["match", ["get", "class"], ["motorway", "trunk"], 2, 1], 16, ["match", ["get", "class"], ["motorway", "trunk", "primary"], 8, 5], 20, 24]}},
    {"id": "rail", "type": "line", "source": "vector", "source-layer": "transportation", "filter": ["==", ["get", "class"], "rail"], "minzoom": 11,
      "paint": {"line-color": "#b4b0aa", "line-width": 1, "line-dasharray": [3, 2]}},
    {"id": "protomaps-roads-minor", "type": "line", "source": "vector", "source-layer": "roads",
      "filter": ["match", ["get", "kind"], ["minor_road", "path", "other"], true, false], "minzoom": 12,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 0.5, 16, 4, 20, 18]}},
    {"id": "protomaps-roads-major", "type": "line", "source": "vector", "source-layer": "roads",
      "filter": ["match", ["get", "kind"], ["highway", "major_road", "medium_road"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": ["match", ["get", "kind"], ["highway"], "#f6c48a", ["major_road"], "#fbdca5", "#ffffff"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.5, 10, ["match", ["get", "kind"], ["highway"], 2, 1], 16, ["match", ["get", "kind"], ["highway", "major_road"], 8, 5], 20, 24]}},
    {"id": "protomaps-rail", "type": "line", "source": "vector", "source-layer": "roads", "filter": ["==", ["get", "kind"], "rail"], "minzoom": 11,
      "paint": {"line-color": "#b4b0aa", "line-width": 1, "line-dasharray": [3, 2]}},
    {"id": "streets-minor", "type": "line", "source": "vector", "source-layer": "streets",
      "filter": ["match", ["get", "kind"], ["motorway", "trunk", "primary", "secondary", "tertiary", "rail", "light_rail", "subway", "tram"], false, true], "minzoom": 12,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 0.5, 16, 4, 20, 18]}},
    {"id": "streets-major", "type": "line", "source": "vector", "source-layer": "streets",
      "filter": ["match", ["get", "kind"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {"line-color": ["match", ["get", "kind"], ["motorway", "trunk"], "#f6c48a", ["primary"], "#fbdca5", "#ffffff"],
        "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 5, 0.5, 10, ["match", ["get", "kind"], ["motorway", "trunk"], 2, 1], 16, ["match", ["get", "kind"], ["motorway", "trunk", "primary"], 8, 5], 20, 24]}},
    {"id": "boundary", "type": "line", "source": "vector", "source-layer": "boundary", "filter": ["<=", ["to-number", ["get", "admin_level"]], 4],
      "paint": {"line-color": "#9e9cab", "line-width": ["match", ["to-number", ["get", "admin_level"]], 2, 1.2, 0.7], "line-dasharray": [4, 2]}},
    {"id": "boundaries", "type": "line", "source": "vector", "source-layer": "boundaries",
      "filter": ["<=", ["to-number", ["coalesce", ["get", "admin_level"], ["get", "kind_detail"], 2]], 4],
      "paint": {"line-color": "#9e9cab", "line-width": ["match", ["to-number", ["coalesce", ["get", "admin_level"], ["get", "kind_detail"], 2]], 2, 1.2, 0.7], "line-dasharray": [4, 2]}},
    {"id": "water-name", "type": "symbol", "source": "vector", "source-layer": "water_name",
      "layout": {"text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-size": 12, "text-font": ["Italic"]},
      "paint": {"text-color": "#4d7fa3", "text-halo-color": "#ffffff", "text-halo-width": 1}},
    {"id": "place", "type": "symbol", "source": "vector", "source-layer": "place",
      "filter": ["match", ["get", "class"], ["country", "state", "city", "town", "village"], true, false],
      "layout": {"text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["match", ["get", "class"], "country", 14, "state", 12, "city", 14, "town", 12, 11],
        "symbol-sort-key": ["match", ["get", "class"], "country", 0, "state", 1, "city", 2, "town", 3, 4],
        "text-transform": ["match", ["get", "class"], "state", "uppercase", "none"],
        "text-font": ["match", ["get", "class"], ["country", "city"], ["literal", ["Bold"]], ["literal", ["Regular"]]]},
      "paint": {"text-color": ["match", ["get", "class"], ["country", "state"], "#6b6b80", "#333333"], "text-halo-color": "#ffffff", "text-halo-width": 1.2}},
    {"id": "places", "type": "symbol", "source": "vector", "source-layer": "places",
      "filter": ["match", ["get", "kind"], ["country", "region", "locality"], true, false],
      "layout": {"text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-size": ["match", ["get", "kind"], "country", 14, "region", 12, 12],
        "symbol-sort-key": ["coalesce", ["get", "min_zoom"], ["match", ["get", "kind"], "country", 0, "region", 1, 3]],
        "text-font": ["match", ["get", "kind"], ["country"], ["literal", ["Bold"]], ["literal", ["Regular"]]]},
      "paint": {"text-color": ["match", ["get", "kind"], ["country", "region"], "#6b6b80", "#333333"], "text-halo-color": "#ffffff", "text-halo-width": 1.2}},
    {"id": "place-labels", "type": "symbol", "source": "vector", "source-layer": "place_labels",
      "layout": {"text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-size": ["match", ["get", "kind"], ["capital", "state_capital", "city"], 14, 12],
        "symbol-sort-key": ["match", ["get", "kind"], "capital", 0, "state_capital", 1, "city", 2, "town", 3, 4]},
      "paint": {"text-color": "#333333", "text-halo-color": "#ffffff", "text-halo-width": 1.2}}
  ]
}
