{
  "title": "Handoff",
  "type": "object",
  "required": [
    "task_id",
    "goal",
    "done",
    "todo",
    "artifacts",
    "verification",
    "risks",
    "next_action",
    "spec_versions"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "todo": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "output_ref": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "pass"
                }
              },
              "required": [
                "result"
              ]
            },
            "then": {
              "required": [
                "output_ref"
              ]
            }
          }
        ]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 5
    },
    "spec_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
