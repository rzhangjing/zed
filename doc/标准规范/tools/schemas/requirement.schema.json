{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "domain",
    "reporter",
    "background",
    "goal",
    "scenarios",
    "functional",
    "nonfunctional",
    "acceptance",
    "out_of_scope",
    "deps",
    "risks",
    "open_questions",
    "priority",
    "estimate",
    "dedup",
    "version"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 30
    },
    "type": {
      "enum": [
        "feature",
        "improve",
        "bug",
        "debt",
        "experiment"
      ]
    },
    "domain": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "reporter": {
      "type": "string",
      "minLength": 2
    },
    "background": {
      "type": "string",
      "maxLength": 200
    },
    "goal": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "metric",
          "current",
          "target",
          "source"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "current": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "functional": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FR-[0-9]+$"
          },
          "text": {
            "type": "string",
            "minLength": 4
          }
        }
      }
    },
    "nonfunctional": {
      "type": "object",
      "required": [
        "performance",
        "security",
        "retention"
      ],
      "properties": {
        "performance": {
          "type": "string",
          "minLength": 2
        },
        "security": {
          "type": "string",
          "minLength": 2
        },
        "retention": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "given",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "kind": {
            "enum": [
              "normal",
              "boundary",
              "exception"
            ]
          },
          "given": {
            "type": "string",
            "minLength": 3
          },
          "when": {
            "type": "string",
            "minLength": 3
          },
          "then": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "status"
        ],
        "properties": {
          "question": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "accepted"
            ]
          },
          "answer": {
            "type": "string"
          }
        }
      }
    },
    "priority": {
      "type": "object",
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "enum": [
            1,
            2,
            3,
            4
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "estimate": {
      "type": "object",
      "required": [
        "optimistic",
        "pessimistic"
      ],
      "properties": {
        "optimistic": {
          "type": "number",
          "maximum": 5
        },
        "pessimistic": {
          "type": "number",
          "maximum": 5
        },
        "uncertainty": {
          "type": "string"
        }
      }
    },
    "dedup": {
      "enum": [
        "none",
        "merged"
      ]
    },
    "merged_into": {
      "type": "string",
      "pattern": "^REQ-[0-9]{4}$"
    },
    "security_opinion": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "baseline": {
      "type": "boolean",
      "default": false
    },
    "baseline_at": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dedup": {
            "const": "merged"
          }
        },
        "required": [
          "dedup"
        ]
      },
      "then": {
        "required": [
          "merged_into"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "baseline": {
            "const": true
          }
        },
        "required": [
          "baseline"
        ]
      },
      "then": {
        "required": [
          "baseline_at"
        ]
      }
    }
  ]
}
